<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mault Property - Western Cape</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,Arial}
body{background:#080808;color:white}
a{text-decoration:none;color:inherit}
nav{max-width:1300px;margin:0 auto;padding:20px;display:flex;justify-content:space-between;border-bottom:1px solid #1a1a1a}
.hero{max-width:1300px;margin:50px auto;padding:0 20px}
.hero h1{font-size:56px;line-height:1}
.hero span{color:#888}
.filters{background:#111;border:1px solid #222;padding:20px;border-radius:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:15px;margin-top:30px}
select,input{background:#0a0a0a;border:1px solid #222;padding:12px;border-radius:12px;color:white;width:100%}
.grid{max-width:1300px;margin:40px auto;padding:0 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px}
.card{background:#111;border:1px solid #1e1e1e;border-radius:24px;overflow:hidden}
.card-img{height:220px;background:#222;position:relative;display:flex;align-items:center;justify-content:center;font-size:50px}
.badge{position:absolute;top:15px;left:15px;background:white;color:black;padding:6px 12px;border-radius:100px;font-size:12px;font-weight:800}
.price{position:absolute;bottom:15px;left:15px;background:black;padding:8px 14px;border-radius:100px;font-weight:800}
.card-body{padding:20px}
.btn{display:block;text-align:center;background:white;color:black;padding:14px;border-radius:100px;margin-top:12px;font-weight:800;cursor:pointer}
.btn2{background:transparent;border:1px solid #333;color:white}
.owner-box{max-width:1300px;margin:80px auto;padding:40px 20px;background:#111;border:1px solid #222;border-radius:24px;display:grid;grid-template-columns:1fr 1fr;gap:30px}
@media(max-width:800px){.hero h1{font-size:36px}.owner-box{grid-template-columns:1fr}}
</style>
</head>
<body>
<nav><div style="font-weight:900">MAULT PROPERTY_</div><div><a href="/" style="color:#666">← MOTHER</a> <span style="color:#222">|</span> <a href="mailto:tech@maultgroup.com" style="color:#666">tech@maultgroup.com</a></div></nav>

<div class="hero">
<h1>Western Cape<br><span>Property Marketplace</span></h1>
<p style="color:#666;margin-top:15px;max-width:600px">Rentals & Sales across WC. Landlords list FREE. Commission only when deal closes. Contact: tech@maultgroup.com</p>

<div class="filters">
<div><select id="fType" onchange="filter()"><option value="all">All - Rent & Sale</option><option value="rent">For Rent</option><option value="sale">For Sale</option></select></div>
<div><select id="fArea" onchange="filter()"><option value="all">All WC</option><option value="CBD">CBD</option><option value="Bellville">Bellville</option><option value="Stellenbosch">Stellenbosch</option><option value="Paarl">Paarl</option><option value="Khayelitsha">Khayelitsha</option></select></div>
<div><input id="fPrice" type="number" placeholder="Min Price R" oninput="filter()"></div>
<div><select id="fBed" onchange="filter()"><option value="0">Any Beds</option><option value="1">1+ Bed</option><option value="2">2+ Beds</option></select></div>
</div>
</div>

<div class="grid" id="grid">
<div class="card" data-type="rent" data-area="CBD" data-price="8500" data-bed="2">
<div class="card-img">🏢<div class="badge">FOR RENT</div><div class="price">R8,500 /mo</div></div>
<div class="card-body"><h3>2 Bed - CBD</h3><div style="color:#666;font-size:13px;margin-top:8px">📍 Loop Street • 2 Bed • 65m²</div>
<button class="btn" onclick="enquire('2 Bed CBD R8500')">WhatsApp Enquiry</button>
<button class="btn btn2" onclick="emailEnquire('2 Bed CBD R8500')">Email: tech@maultgroup.com</button>
</div></div>

<div class="card" data-type="sale" data-area="Bellville" data-price="1250000" data-bed="3">
<div class="card-img">🏠<div class="badge" style="background:#0f0">FOR SALE</div><div class="price">R1,250,000</div></div>
<div class="card-body"><h3>3 Bed - Bellville</h3><div style="color:#666;font-size:13px;margin-top:8px">📍 Bellville South • 3 Bed • Yard</div>
<button class="btn" onclick="enquire('3 Bed Bellville R1.25m')">WhatsApp Enquiry</button>
<button class="btn btn2" onclick="emailEnquire('3 Bed Bellville R1.25m')">Email: tech@maultgroup.com</button>
</div></div>

<div class="card" data-type="rent" data-area="Stellenbosch" data-price="12000" data-bed="3">
<div class="card-img">🌳<div class="badge">FOR RENT</div><div class="price">R12,000 /mo</div></div>
<div class="card-body"><h3>3 Bed - Stellenbosch</h3><div style="color:#666;font-size:13px;margin-top:8px">📍 University Area • Students Welcome</div>
<button class="btn" onclick="enquire('3 Bed Stellenbosch R12k')">WhatsApp Enquiry</button>
<button class="btn btn2" onclick="emailEnquire('3 Bed Stellenbosch R12k')">Email: tech@maultgroup.com</button>
</div></div>
</div>

<div class="owner-box">
<div><h2>Landlord / Agent?</h2><p style="color:#666;margin-top:10px">List FREE. Pay only when closed. 50% first month (rent) or 2% (sale).</p><p style="margin-top:20px">📧 <a href="mailto:tech@maultgroup.com?subject=List My Property WC" style="color:white;text-decoration:underline">tech@maultgroup.com</a><br>📱 WhatsApp: 070 000 0000</p></div>
<div><input id="lName" placeholder="Your Name"><br><br><input id="lPrice" placeholder="e.g. Rent R8000 or Sale R1.2m"><br><br><input id="lDetails" placeholder="Details: 2 bed, etc"><br><br>
<button class="btn" style="width:100%" onclick="listProp()">List via WhatsApp</button>
<button class="btn btn2" style="width:100%;margin-top:10px" onclick="listEmail()">List via Email</button>
</div></div>

<p style="text-align:center;color:#333;padding:40px">© 2026 Mault Property • tech@maultgroup.com • Division of Mault Group</p>

<script>
function filter(){
let t=fType.value,a=fArea.value,p=fPrice.value||0,b=fBed.value;
document.querySelectorAll('.card').forEach(c=>{
let show=true;
if(t!='all'&&c.dataset.type!=t)show=false;
if(a!='all'&&c.dataset.area!=a)show=false;
if(parseInt(c.dataset.price)<parseInt(p))show=false;
if(parseInt(c.dataset.bed)<parseInt(b))show=false;
c.style.display=show?'block':'none';
});
}
function enquire(prop){
window.open('https://wa.me/27700000000?text='+encodeURIComponent('Hi Mault Property! Interested in '+prop),'_blank');
}
function emailEnquire(prop){
window.location.href='mailto:tech@maultgroup.com?subject=Enquiry: '+encodeURIComponent(prop)+'&body=Hi Mault Team, I am interested in '+encodeURIComponent(prop)+'. Please contact me.';
}
function listProp(){
let msg=`Hi Mault Property! List my property. Name: ${lName.value}, Price: ${lPrice.value}, Details: ${lDetails.value}`;
window.open('https://wa.me/27+736388901?text='+encodeURIComponent(msg),'_blank');
}
function listEmail(){
let sub=`List My Property: ${lPrice.value}`;
let body=`Name: ${lName.value}%0D%0APrice: ${lPrice.value}%0D%0ADetails: ${lDetails.value}`;
window.location.href=`mailto:maulthq014@gmail.com?subject=${encodeURIComponent(sub)}&body=${body}`;
}
</script>
</body>
</html>
